/********************************** */
/*************** navigation js   */
/******************************** */
(function ($) {
    function elementoNavigationInit($scope, $) {

        // Add class to last menu item
        $scope.find('nav.elemento-nav-menu[data-last-item="yes"]').each(function () {
            var $topLevelUL = $(this).children('ul').first();
            $topLevelUL.children('li:last-child').addClass('elemento-button');
        });

        // Mobile toggle button
        $scope.find('.elemento-nav-toggle').off('click').on('click', function (e) {
            e.preventDefault();
            let $toggle = $(this);
            $toggle.toggleClass('menu-opened');
            $toggle.siblings('nav').toggleClass('elemento-menu-open');

            // Icon toggle
            $toggle.find('.icon-normal').toggle();
            $toggle.find('.icon-active').toggle();

            $toggle.attr('aria-expanded', $toggle.hasClass('menu-opened'));
        });
        
        // fly menu close
        $scope.find('.elemento-nav-menu .close-icon').off('click').on('click', function (e) {
            e.preventDefault();
            const $nav = $(this).closest('nav.elemento-nav-menu');
            const $container = $nav.closest('[class*="fly_"]');
            const $toggle = $container.find('.elemento-nav-toggle');

            $toggle.removeClass('menu-opened');
            $nav.removeClass('elemento-menu-open');

            $toggle.find('.icon-normal').show();
            $toggle.find('.icon-active').hide();

            $toggle.attr('aria-expanded', 'false');
        });

        // Submenu toggle
        $scope.find('.elemento-nav-menu .elemento-menu-toggle').off('click').on('click', function (e) {
            e.preventDefault();
            $(this).closest('li').children('.sub-menu').slideToggle(200);
            $(this).toggleClass('open');
        });

        // Close menu when clicking outside (global listener)
        $(document).off('click.elementoNav').on('click.elementoNav', function (event) {
            if (!$(event.target).closest('.nav-menu-container').length) {
                $('.elemento-menu-open').removeClass('elemento-menu-open');
                $('.elemento-nav-toggle').removeClass('menu-opened');
            }
        });
    }
    // Hook into Elementor's frontend/init to bind for both frontend and editor
    $(window).on('elementor/frontend/init', function () {
        // Global hook (fires for every widget)
        elementorFrontend.hooks.addAction('frontend/element_ready/global', elementoNavigationInit);
    });

})(jQuery);